TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

AUTH_ISSUER=https://auth.rxlab.app
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=
DESKTOP_AUTH_CLIENT_ID=filmstudio-macos

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
# Off means no credit reservation is taken, so every generation is booked at
# platform scope with no user and no charge — nothing shows under /usage.
BILLING_ENABLED=true

# Vercel AI Gateway: chat and provider-qualified image models such as
# openai/gpt-image-1.
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Direct OpenAI access is currently used only by whisper-1 transcription.
OPENAI_API_KEY=

# S3-compatible object storage. Cloudflare R2 uses region=auto and the
# account-level endpoint (do not append the bucket name).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
S3_PRESIGN_TTL_SECONDS=900
# R2 custom domain or r2.dev public bucket URL.
S3_PUBLIC_URL=https://media.filmstudio.rxlab.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
DEV_BYPASS_AUTH=false
