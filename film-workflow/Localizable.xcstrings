    },
    "The marketplace has no slot for this clip’s file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市场没有用于此片段文件的插槽。"
          }
        }
      }
    },
    "The model decides where a long caption should break — at a clause boundary, never mid-phrase, and never leaving a stub second line. It leaves a caption alone when no split improves it. The length above is the threshold it works to." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由模型决定长字幕在哪里断开——在语义停顿处断句，不会拆散词组，也不会留下过短的第二行。如果拆分没有好处，就保持原样。上面的长度是它参照的阈值。"
          }
        }
      }
    },
    "The model didn't find anything worth changing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型没有发现需要修改的地方。"
          }
        }
      }
    },
