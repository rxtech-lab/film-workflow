    "%@ are installed globally and do not need adding to a film." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 为全局安装，无需添加到影片。"
          }
        }
      }
    },
    "%@ can't express inline word timings, so sentence cues will be exported instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
