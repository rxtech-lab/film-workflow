    "%@ can't express inline word timings, so sentence cues will be exported instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法表示内嵌的逐字时间，将改为导出整句字幕。"
          }
        }
      }
    },
    "%@ doesn't detect speakers. You can select captions in the editor and assign speakers in bulk." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不识别说话人。你可以在编辑器中选择字幕，批量指定说话人。"
          }
        }
      }
    },
    "%@ doesn't return word timings, so narrative timings will be estimated. Azure or on-device Whisper give much better results." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不返回逐字时间，旁白时间轴将为估算值。使用 Azure 或本机 Whisper 效果会好得多。"
          }
        }
      }
    },
    "%@ doesn't return word timings, so word-level export will be approximated." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不返回逐字时间，逐字导出将为近似值。"
          }
        }
      }
    },
    "%@ returns no word timings, so caption times will be estimated. Azure or on-device Whisper are much more accurate here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
