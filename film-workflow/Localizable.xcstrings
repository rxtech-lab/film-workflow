    "Apple Intelligence" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 智能"
          }
        }
      }
    },
    "Apple Intelligence is still downloading its model. Try again shortly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 智能正在下载模型，请稍后再试。"
          }
        }
      }
    },
    "Apple Intelligence isn't available right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前无法使用 Apple 智能。"
          }
        }
      }
    },
    "Apple Intelligence runs on device and cannot call tools, so it can answer questions but not change your projects. Caption edits are the exception — it can still propose those." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在设备上运行，无法调用工具，因此可以回答问题，但不能修改你的项目。字幕编辑是例外——它仍可以提出编辑建议。"
          }
        }
      }
    },
    "Apple Intelligence stays on device. The other backends use your provider settings or a CLI you already have installed." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在设备端运行。其他后端使用您的服务商设置，或已安装的命令行工具。"
          }
        }
      }
    },
    "Apple Intelligence stays on device. The others use your RxFilm subscription, your own OpenAI-compatible endpoint, or a CLI you already have installed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 保留在设备上运行。其他引擎使用你的 RxFilm 订阅、你自己的 OpenAI 兼容端点，或已安装的命令行工具。"
          }
        }
      }
    },
    "Apple Maps" : {

    },
    "Apple Translation" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 翻译"
          }
        }
      }
    },
    "Apple's engine can't be given the glossary, so these captions won't pick up later changes to a term's translation. Use an AI model if you want them to." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将术语表提供给 Apple 的引擎，因此这些字幕不会跟随术语翻译之后的更改。如果需要此功能，请使用 AI 模型。"
          }
        }
      }
    },
    "Applied %lld change%@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applied %1$lld change%2$@."
          }
        },
        "zh-Hans" : {
