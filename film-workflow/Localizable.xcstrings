    },
    "\"%@\" and its known spelling variants will be permanently deleted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其已知拼写变体将被永久删除。"
          }
        }
      }
    },
    "“%@” is stored as a draft. Publish it from My Marketplace once its cover art is in place." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已保存为草稿。封面就绪后，可从“我的市场”发布。"
          }
        }
      }
    },
    "\"%@\" isn't a glossary term — it will show as written." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是术语表词条，将按原样显示。"
          }
        }
      }
    },
    "“%@” was added to %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已添加到 %@。"
          }
        }
      }
    },
    "\"%@\" will be deleted. Its projects will be kept and moved to Ungrouped." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被删除。其中的项目会保留并移至“未分组”。"
          }
        }
      }
    },
    "\"%@\" will be deleted. Their paragraphs will be reassigned to the first remaining speaker." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被删除。其中的段落会重新分配给第一位剩余说话人。"
          }
        }
      }
    },
    "“merge captions 12 and 13”, “fix every RxLab spelling”, “split #4 so the second line isn't so long”." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“把第 12 和 13 条字幕合并”“把所有 RxLab 的拼写改对”“拆分 #4，别让第二行那么长”。"
          }
        }
      }
    },
    "“merge captions 12 and 13”, “make the title yellow and slow the fade”, “put the narration under the video and render it”, “export the captions as SRT”." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“合并字幕 12 和 13”“将标题设为黄色并放慢淡出”“将旁白放在视频下方并渲染”“将字幕导出为 SRT”。"
          }
        }
      }
    },
