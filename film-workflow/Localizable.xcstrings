    },
    "Applied %lld of %lld." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applied %1$lld of %2$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已应用 %1$lld/%2$lld。"
          }
        }
      }
    },
    "Applies only to runs of text with no sentence punctuation. Commas never split a caption." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅适用于没有句末标点的连续文字。逗号绝不会拆分字幕。"
          }
        }
      }
    },
    "Apply %@" : {
