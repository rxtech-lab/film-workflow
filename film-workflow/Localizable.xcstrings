        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用 %@"
          }
        }
      }
    },
    "Apply a template to a new sequence in your current film, then refine the edit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在当前影片的新序列中应用模板，再继续完善剪辑。"
