<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox is disabled for macOS so the app can spawn the embedded Bun runtime
	     and let it freely manage its working directory under Application Support.
	     iOS targets ignore this and continue to run under their normal sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Bun uses JIT; hardened runtime needs to allow it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Passkey sign-in. AuthenticationServices only honours a passkey request
	     whose relying party is covered here, and the domain must list this app's
	     <TEAMID>.<BUNDLEID> in its AASA:
	     https://rxlab.app/.well-known/apple-app-site-association
	     The ?mode=developer variant lets a locally built app validate against
	     the live AASA without waiting on Apple's CDN cache. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:rxlab.app</string>
		<string>webcredentials:rxlab.app?mode=developer</string>
	</array>
</dict>
</plist>
